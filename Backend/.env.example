# Copy this file to .env (or .env_dev / .env_test) and fill in real values.
# Never commit the real .env / .env_dev / .env_test files.

# MongoDB connection string (Atlas or local)
DB_CONNECT=mongodb+srv://<user>:<password>@<cluster>/<database>

# JWT secret used to sign access/refresh tokens - use a long random string
TOKEN_SECRET=replace-with-a-long-random-secret

# Access token lifetime (e.g. 15m, 1h)
TOKEN_EXPIRATION=15m

# Refresh token lifetime (e.g. 7d, 30d)
REFRESH_TOKEN_EXPIRATION=7d

# Base URL used to build absolute links to uploaded files
DOMAIN_BASE=http://localhost:3000

# Port the backend server listens on
PORT=3000

# Allowed origin for CORS (the frontend dev server URL)
CLIENT_ORIGIN=http://localhost:5173
